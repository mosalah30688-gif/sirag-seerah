[
  {
    "id": 1,
    "text": "كان رسول الله ﷺ أحسن الناس وجهاً وأحسنهم خلقاً",
    "narrator": "البراء بن عازب",
    "source": "البخاري 3556",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 2,
    "text": "إنما بعثت لأتمم صالح الأخلاق",
    "narrator": "أبو هريرة",
    "source": "مسند أحمد 8952",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 3,
    "text": "ما خُيّر رسول الله ﷺ بين أمرين إلا اختار أيسرهما ما لم يكن إثماً",
    "narrator": "عائشة",
    "source": "البخاري 3560",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 4,
    "text": "كان رسول الله ﷺ أجود الناس وكان أجود ما يكون في رمضان",
    "narrator": "ابن عباس",
    "source": "البخاري 6",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 5,
    "text": "إن الله اصطفى كنانة من ولد إسماعيل واصطفى قريشاً من كنانة واصطفاني من قريش",
    "narrator": "واثلة بن الأسقع",
    "source": "مسلم 2276",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 6,
    "text": "أنا سيد ولد آدم يوم القيامة وأول من ينشق عنه القبر",
    "narrator": "أبو هريرة",
    "source": "مسلم 2278",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 7,
    "text": "بُعثتُ بالحنيفية السمحة",
    "narrator": "عائشة",
    "source": "أحمد 24369",
    "grade": "حسن",
    "topic": "السيرة"
  },
  {
    "id": 8,
    "text": "كان خلقه القرآن",
    "narrator": "عائشة",
    "source": "مسلم 746",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 9,
    "text": "ما ضرب رسول الله ﷺ بيده خادماً ولا امرأة قط",
    "narrator": "عائشة",
    "source": "مسلم 2328",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 10,
    "text": "كان رسول الله ﷺ طويل الصمت قليل الضحك",
    "narrator": "جابر بن سمرة",
    "source": "أحمد 20836",
    "grade": "حسن",
    "topic": "السيرة"
  },
  {
    "id": 11,
    "text": "إن الله بعثني رحمة للعالمين",
    "narrator": "أبو هريرة",
    "source": "مسلم 2599",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 12,
    "text": "أنا النبي لا كذب أنا ابن عبد المطلب",
    "narrator": "البراء",
    "source": "البخاري 3042",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 13,
    "text": "نُصرت بالرعب مسيرة شهر",
    "narrator": "أبو هريرة",
    "source": "البخاري 335",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 14,
    "text": "جُعل رزقي تحت ظل رمحي",
    "narrator": "ابن عمر",
    "source": "أحمد 5667",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 15,
    "text": "اللهم لا عيش إلا عيش الآخرة فاغفر للأنصار والمهاجرة",
    "narrator": "أنس",
    "source": "البخاري 3795",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 16,
    "text": "من جهز جيش العسرة فله الجنة",
    "narrator": "عثمان",
    "source": "البخاري 2787",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 17,
    "text": "ما ضر عثمان ما عمل بعد اليوم",
    "narrator": "عبد الرحمن بن سمرة",
    "source": "الترمذي 3701",
    "grade": "حسن",
    "topic": "السيرة"
  },
  {
    "id": 18,
    "text": "لو كنت متخذاً خليلاً لاتخذت أبا بكر",
    "narrator": "ابن مسعود",
    "source": "البخاري 3656",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 19,
    "text": "سدوا الأبواب إلا باب أبي بكر",
    "narrator": "ابن عباس",
    "source": "البخاري 467",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 20,
    "text": "أبو بكر وعمر سيدا كهول أهل الجنة",
    "narrator": "علي",
    "source": "الترمذي 3664",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 21,
    "text": "علي مني وأنا منه",
    "narrator": "حبان بن الحكم",
    "source": "البخاري 3706",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 22,
    "text": "فاطمة بضعة مني من أغضبها أغضبني",
    "narrator": "المسور",
    "source": "البخاري 3714",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 23,
    "text": "الحسن والحسين سيدا شباب أهل الجنة",
    "narrator": "أبو سعيد",
    "source": "الترمذي 3768",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 24,
    "text": "خديجة خير نسائها",
    "narrator": "علي",
    "source": "البخاري 3815",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 25,
    "text": "بشر خديجة ببيت في الجنة من قصب",
    "narrator": "أبو هريرة",
    "source": "البخاري 3820",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 26,
    "text": "عائشة أحب الناس إلي",
    "narrator": "عمرو بن العاص",
    "source": "البخاري 3662",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 27,
    "text": "كمل من الرجال كثير ولم يكمل من النساء إلا آسية ومريم",
    "narrator": "أبو موسى",
    "source": "البخاري 3411",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 28,
    "text": "تزوج النبي خديجة وهو ابن 25",
    "narrator": "عائشة",
    "source": "البخاري 3821",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 29,
    "text": "ما أبدلني الله خيراً منها — يعني خديجة",
    "narrator": "عائشة",
    "source": "البخاري 3821",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 30,
    "text": "كان يذكر خديجة حتى تغار عائشة",
    "narrator": "عائشة",
    "source": "البخاري 3818",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 31,
    "text": "أول ما بدئ به الوحي الرؤيا الصالحة",
    "narrator": "عائشة",
    "source": "البخاري 3",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 32,
    "text": "اقرأ باسم ربك الذي خلق",
    "narrator": "عائشة",
    "source": "البخاري 3",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 33,
    "text": "زملوني زملوني",
    "narrator": "عائشة",
    "source": "البخاري 4",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 34,
    "text": "يا أيها المدثر قم فأنذر",
    "narrator": "جابر",
    "source": "البخاري 4922",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 35,
    "text": "والله لا يخزيك الله أبداً — قول خديجة",
    "narrator": "عائشة",
    "source": "البخاري 3",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 36,
    "text": "أتى جبريل النبي فقال: هذه خديجة قد أتت",
    "narrator": "أبو هريرة",
    "source": "البخاري 3820",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 37,
    "text": "صعد النبي الصفا فنادى: يا صباحاه",
    "narrator": "ابن عباس",
    "source": "البخاري 3525",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 38,
    "text": "تبت يدا أبي لهب وتب",
    "narrator": "ابن عباس",
    "source": "البخاري 4971",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 39,
    "text": "كان أبو جهل ينهى النبي عن الصلاة",
    "narrator": "ابن عباس",
    "source": "البخاري 4959",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 40,
    "text": "لقد أوذي النبي في الله وما يؤذى أحد",
    "narrator": "أنس",
    "source": "الترمذي 2477",
    "grade": "حسن",
    "topic": "السيرة"
  },
  {
    "id": 41,
    "text": "اشتد أذى قريش بعد موت أبي طالب",
    "narrator": "عائشة",
    "source": "البخاري 3852",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 42,
    "text": "عرض نفسه على القبائل فقال: من يؤويني؟",
    "narrator": "جابر",
    "source": "أحمد 14488",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 43,
    "text": "جاءه ملك الجبال في الطائف",
    "narrator": "عائشة",
    "source": "البخاري 3231",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 44,
    "text": "اللهم إليك أشكو ضعف قوتي",
    "narrator": "عبد الله بن جعفر",
    "source": "الطبراني",
    "grade": "حسن",
    "topic": "السيرة"
  },
  {
    "id": 45,
    "text": "أُسري بي ليلاً من المسجد الحرام",
    "narrator": "أنس",
    "source": "البخاري 3886",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 46,
    "text": "فرضت الصلاة ليلة الإسراء خمسين ثم خففت لخمس",
    "narrator": "أنس",
    "source": "البخاري 349",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 47,
    "text": "مررت بموسى ليلة أسري بي",
    "narrator": "ابن عباس",
    "source": "البخاري 3396",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 48,
    "text": "بايعوني على أن لا تشركوا بالله",
    "narrator": "عبادة بن الصامت",
    "source": "البخاري 18",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 49,
    "text": "الأنصار شعار والناس دثار",
    "narrator": "البراء",
    "source": "البخاري 3779",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 50,
    "text": "طلع البدر علينا من ثنيات الوداع",
    "narrator": "البراء",
    "source": "أحمد 12497",
    "grade": "حسن",
    "topic": "السيرة"
  },
  {
    "id": 51,
    "text": "لا تحزن إن الله معنا",
    "narrator": "أبو بكر",
    "source": "البخاري 3653",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 52,
    "text": "ما ظنك باثنين الله ثالثهما؟",
    "narrator": "أبو بكر",
    "source": "البخاري 3653",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 53,
    "text": "بنى المسجد بيديه وينقل اللبن",
    "narrator": "أنس",
    "source": "البخاري 3906",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 54,
    "text": "آخى بين سلمان وأبي الدرداء",
    "narrator": "أنس",
    "source": "البخاري 1968",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 55,
    "text": "لو سلك الناس وادياً وسلكت الأنصار شعباً لسلكت شعب الأنصار",
    "narrator": "أنس",
    "source": "البخاري 3778",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 56,
    "text": "الأذان رؤيا عبد الله بن زيد",
    "narrator": "عبد الله بن زيد",
    "source": "أبو داود 499",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 57,
    "text": "حولت القبلة إلى الكعبة",
    "narrator": "البراء",
    "source": "البخاري 403",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 58,
    "text": "فرض صيام رمضان 2هـ",
    "narrator": "ابن عمر",
    "source": "البخاري 8",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 59,
    "text": "تزوج علي فاطمة على درع",
    "narrator": "علي",
    "source": "النسائي 3375",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 60,
    "text": "الحسن أشبه برسول الله",
    "narrator": "أنس",
    "source": "البخاري 3752",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 61,
    "text": "نصرت بالرعب وأوتيت جوامع الكلم",
    "narrator": "أبو هريرة",
    "source": "البخاري 2977",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 62,
    "text": "دعا ليلة بدر: اللهم إن تهلك هذه العصابة",
    "narrator": "ابن عباس",
    "source": "البخاري 2915",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 63,
    "text": "قوموا إلى جنة عرضها السماوات والأرض",
    "narrator": "أنس",
    "source": "مسلم 1901",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 64,
    "text": "أشار بالسيف يوم بدر: هذا مصرع فلان",
    "narrator": "أنس",
    "source": "مسلم 1779",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 65,
    "text": "قتل أبو جهل يوم بدر",
    "narrator": "ابن مسعود",
    "source": "البخاري 3962",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 66,
    "text": "اختلف الرماة يوم أحد فهزمنا",
    "narrator": "البراء",
    "source": "البخاري 3039",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 67,
    "text": "من يرد الله به خيراً يفقهه في الدين",
    "narrator": "معاوية",
    "source": "البخاري 71",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 68,
    "text": "حمزة سيد الشهداء",
    "narrator": "جابر",
    "source": "الطبراني",
    "grade": "حسن",
    "topic": "السيرة"
  },
  {
    "id": 69,
    "text": "مثل حمزة وبكى",
    "narrator": "جابر",
    "source": "البخاري 1244",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 70,
    "text": "قنت شهراً يدعو على رعل وذكوان",
    "narrator": "أنس",
    "source": "البخاري 1002",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 71,
    "text": "خبيب أول من سن ركعتي القتل",
    "narrator": "أبو هريرة",
    "source": "البخاري 3045",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 72,
    "text": "هو الذي أخرج الذين كفروا من أهل الكتاب",
    "narrator": "ابن عمر",
    "source": "البخاري 4882",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 73,
    "text": "حفر الخندق وشارك جوعاً",
    "narrator": "جابر",
    "source": "البخاري 3070",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 74,
    "text": "اللهم لا عيش إلا عيش الآخرة",
    "narrator": "أنس",
    "source": "البخاري 2961",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 75,
    "text": "جاع النبي حتى ربط الحجر على بطنه",
    "narrator": "أنس",
    "source": "البخاري 5416",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 76,
    "text": "أطعم ألفاً من صاع شعير وعناق",
    "narrator": "جابر",
    "source": "البخاري 3070",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 77,
    "text": "ورد الله الذين كفروا بغيظهم",
    "narrator": "عائشة",
    "source": "البخاري 4114",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 78,
    "text": "حكم سعد في بني قريظة",
    "narrator": "أبو سعيد",
    "source": "البخاري 3043",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 79,
    "text": "إنا فتحنا لك فتحاً مبيناً — الحديبية",
    "narrator": "البراء",
    "source": "البخاري 4172",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 80,
    "text": "بايعنا تحت الشجرة على الموت",
    "narrator": "سلمة بن الأكوع",
    "source": "البخاري 2958",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 81,
    "text": "أرسل إلى هرقل: أسلم تسلم",
    "narrator": "ابن عباس",
    "source": "البخاري 7",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 82,
    "text": "مزق كسرى كتابه فمزق الله ملكه",
    "narrator": "ابن عباس",
    "source": "البخاري 4424",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 83,
    "text": "لأعطين الراية رجلاً يحب الله ورسوله — خيبر",
    "narrator": "سهل بن سعد",
    "source": "البخاري 3009",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 84,
    "text": "أنا الذي سمتني أمي حيدرة — علي بخيبر",
    "narrator": "سلمة",
    "source": "مسلم 1807",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 85,
    "text": "الشاة المسمومة قالت: إني مسمومة",
    "narrator": "أنس",
    "source": "البخاري 3169",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 86,
    "text": "تزوج صفية وجعل عتقها صداقها",
    "narrator": "أنس",
    "source": "البخاري 371",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 87,
    "text": "اعتمر عمرة القضاء",
    "narrator": "ابن عمر",
    "source": "البخاري 4256",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 88,
    "text": "ألقى مكة أفلاذ كبدها — خالد وعمرو",
    "narrator": "أنس",
    "source": "أحمد 14764",
    "grade": "حسن",
    "topic": "السيرة"
  },
  {
    "id": 89,
    "text": "قتلت خالداً يوم مؤتة تسعة أسياف",
    "narrator": "خالد",
    "source": "البخاري 4265",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 90,
    "text": "فتح مكة: اذهبوا فأنتم الطلقاء",
    "narrator": "ابن مسعود",
    "source": "البيهقي",
    "grade": "حسن",
    "topic": "السيرة"
  },
  {
    "id": 91,
    "text": "دخل مكة ورأسه على رحله تواضعاً",
    "narrator": "أنس",
    "source": "البخاري 4281",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 92,
    "text": "حطم الأصنام ويقول جاء الحق",
    "narrator": "ابن مسعود",
    "source": "البخاري 4287",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 93,
    "text": "أذن بلال على الكعبة يوم الفتح",
    "narrator": "جابر",
    "source": "البخاري 4400",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 94,
    "text": "أنا النبي لا كذب أنا ابن عبد المطلب — حنين",
    "narrator": "البراء",
    "source": "البخاري 2864",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 95,
    "text": "ناولني كفاً من تراب فرمى وجوههم — حنين",
    "narrator": "العباس",
    "source": "مسلم 1775",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 96,
    "text": "اللهم اهد ثقيفاً",
    "narrator": "جابر",
    "source": "الترمذي 3942",
    "grade": "حسن",
    "topic": "السيرة"
  },
  {
    "id": 97,
    "text": "جهز عثمان جيش العسرة ب300 بعير",
    "narrator": "عبد الرحمن بن سمرة",
    "source": "البخاري 2787",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 98,
    "text": "ما ضر عثمان ما عمل بعد اليوم — تبوك",
    "narrator": "أنس",
    "source": "الترمذي 3701",
    "grade": "حسن",
    "topic": "السيرة"
  },
  {
    "id": 99,
    "text": "كعب بن مالك صدق فتاب الله عليه",
    "narrator": "كعب",
    "source": "البخاري 4418",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 100,
    "text": "اليوم أكملت لكم دينكم — عرفة",
    "narrator": "عمر",
    "source": "البخاري 45",
    "grade": "صحيح",
    "topic": "السيرة"
  },
  {
    "id": 101,
    "text": "وُلد رسول الله ﷺ عام الفيل يوم الاثنين 12 ربيع الأول",
    "narrator": "ابن عباس",
    "source": "سيرة ابن هشام",
    "grade": "حسن",
    "topic": "المولد"
  }
]